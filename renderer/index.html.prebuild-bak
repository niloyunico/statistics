<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>UNICO Healthcare — Statistics Suite</title>
<!-- Offline IBM Plex fonts (vendored locally, no internet) -->
<link rel="stylesheet" href="vendor/fonts/ibm-plex.css"/>
<link rel="stylesheet" href="unico/theme.css"/>
</head>
<body>
<div id="root"></div>
<!-- Off-screen render target for PDF/print export (Reports). Only this node is
     shown under @media print; #root is hidden. See theme.css + reports.jsx. -->
<div id="pdf-root"></div>
<!-- Vendored libraries — run fully offline, no CDN -->
<script src="vendor/react.production.min.js"></script>
<script src="vendor/react-dom.production.min.js"></script>
<script src="vendor/babel.min.js"></script>
<!-- Database bridge: hydrate localStorage from the on-disk DB, then mirror every
     change back to it. Runs before the app's stores read localStorage. -->
<script>
(function(){
  var n = window.unicoNative;
  if(!n){ return; } // opened outside the desktop shell — fall back to plain localStorage
  try{
    // 1) Hydrate: disk database is the source of truth at startup.
    var snap = n.snapshot || {};
    for(var k in snap){ if(Object.prototype.hasOwnProperty.call(snap,k)){ try{ localStorage.setItem(k, snap[k]); }catch(e){} } }
  }catch(e){ try{ console.error('[unico-db] hydrate', e); }catch(_){} }
  try{
    function snapshotAll(){ var all={}; for(var i=0;i<localStorage.length;i++){ var key=localStorage.key(i); all[key]=localStorage.getItem(key); } return all; }
    window.unicoSnapshotAll = snapshotAll;
    window.unicoFlushNow = function(){ try{ return n.persist(snapshotAll()); }catch(e){ return Promise.resolve(); } };
    window.unicoNative = n;
    // 2) Mirror: persist the full state to disk (debounced) on any write.
    var timer=null;
    function schedule(){ clearTimeout(timer); timer=setTimeout(function(){ try{ n.persist(snapshotAll()); }catch(e){} }, 200); }
    var proto = Object.getPrototypeOf(localStorage) || window.Storage.prototype;
    ['setItem','removeItem','clear'].forEach(function(m){
      var orig = proto[m];
      proto[m] = function(){ var r = orig.apply(this, arguments); schedule(); return r; };
    });
  }catch(e){ try{ console.error('[unico-db] mirror', e); }catch(_){} }
})();
</script>
