# UNICO web edition — PRODUCTION environment template (Vercel).
# Copy to ".env.production", fill in REAL values, then import into Vercel:
#   Vercel → Project → Settings → Environment Variables → "Import .env" → this file.
# The real ".env.production" is git-ignored and must NEVER be committed.

# ---- MongoDB Atlas (primary store) ----
# FILL IN your real connection string. For load balancing use a comma-separated
# MONGODB_URIS=uri1,uri2,... instead (reads round-robin, writes broadcast to all).
MONGODB_URI=
# MONGODB_URIS=
DB_NAME=unico

# ---- Login / auth ----
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_TTL=12h
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=

# ---- Web portal ----
REQUIRE_AUTH=true
COOKIE_SECURE=true
NODE_ENV=production

# ---- Redis cache + rate limiting ----
# NOTE: 127.0.0.1 Redis does NOT run on Vercel serverless. Use a managed Redis
# (e.g. Upstash) with a redis:// or rediss:// URL, or leave empty to fall back to
# in-memory (works, but rate limiting/cache is per-function-instance only).
# REDIS_URL=

# ---- Cloudinary (photos/files) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Cloudflare D1 (serverless SQLite) ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Which modules are STORED IN D1 instead of MongoDB (takes storage + write load
# off the Atlas free tier). Migrate the existing rows BEFORE setting this:
#   cd server && node d1-migrate.js && node d1-import.js --verify
# Leave empty to keep everything on MongoDB.
D1_MODULES=activity,supervisor
