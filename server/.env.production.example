# UNICO web edition — PRODUCTION environment template (Vercel).
# Copy to ".env.production", fill in REAL values, then import into Vercel:
#   Vercel → Project → Settings → Environment Variables → "Import .env"
# The real ".env.production" is git-ignored and must NEVER be committed.

# Atlas connection string. Use a DEDICATED user scoped to the "unico" db only.
# ROTATE any password that has ever been shared/screenshotted before going live.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=unico

# Long random secret for login tokens:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_TTL=12h

# First admin account (also the login used in the portal).
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=change-me

# Production = login portal ON, and secure cookies (Vercel serves HTTPS).
REQUIRE_AUTH=true
COOKIE_SECURE=true
NODE_ENV=production
