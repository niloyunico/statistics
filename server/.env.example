# UNICO auth server — copy this file to ".env" and fill it in. NEVER commit .env.
#
# Your Atlas connection string. IMPORTANT:
#   - Use a DEDICATED database user with ONLY readWrite on the "unico" database,
#     NOT the atlasAdmin user. (Atlas -> Database Access -> Add New Database User
#     -> "Built-in role: Read and write to any database" or a custom role scoped
#     to the unico db.)
#   - Rotate ANY password that has ever been shared/screenshotted.
#   - This value lives ONLY here, on the server. It must never go into the desktop app.
#
# LOAD BALANCING: you may connect MORE THAN ONE database. Every READ is served by
# the next healthy database in rotation; every WRITE is broadcast to ALL of them so
# every copy stays identical. Options (in priority order):
#   MONGODB_URIS=uri1,uri2,uri3      comma-separated list
#   MONGODB_URI_1=uri1  MONGODB_URI_2=uri2   numbered vars
#   MONGODB_URI=uri                   single database (original behaviour)
MONGODB_URI=
# MONGODB_URIS=
# MONGODB_URI_1=
# MONGODB_URI_2=

# Database name to use inside the cluster(s).
DB_NAME=unico

# Redis for caching + shared login rate limiting. Falls back to in-memory when
# Redis is not running (ioredis reconnects automatically once it is).
# Install Redis:  https://redis.io/docs/latest/operate/oss_and_stack/install/
REDIS_URL=redis://127.0.0.1:6379

# Photo/file storage (Cloudinary — images + automatic CDN/optimization).
# Get these from https://console.cloudinary.com (Dashboard). The API secret stays
# ONLY on this server: the browser uploads through POST /api/upload (server-side
# upload), never with the secret. Leave blank to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare D1 (serverless SQLite) — reached via the D1 HTTP REST API (no TCP
# connection string). Get these from the Cloudflare dashboard:
#   CLOUDFLARE_ACCOUNT_ID      Workers & Pages → right sidebar → "Account ID"
#   CLOUDFLARE_D1_DATABASE_ID  D1 → your database → "Database ID"
#   CLOUDFLARE_API_TOKEN       My Profile → API Tokens → Create Token → "D1 → Edit"
# Then run `node d1-migrate.js` once to create the starter schema.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Which modules are STORED IN D1 instead of MongoDB. Only latency-tolerant,
# self-contained modules belong here — it takes storage and write load off the
# Atlas free tier. The selected store is the ONLY one written, so migrate the
# existing rows first:  node d1-migrate.js  &&  node d1-import.js --verify
# Set to an empty value to route everything back to MongoDB (instant rollback,
# no need to remove the credentials above). Default when D1 is configured:
D1_MODULES=activity,supervisor

# Long random secret used to sign login tokens. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port the server listens on.
PORT=4000

# Comma-separated list of allowed origins for the desktop app.
# Use "*" while testing; tighten later (e.g. "app://unico").
ALLOWED_ORIGINS=*

# First admin account, created by `npm run seed` (only used for the real DB).
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=

# --- Web ("PC software") server (npm run web) ---
# Port the web edition listens on.
WEB_PORT=8080
# REQUIRE_AUTH=true enables the admin login portal: the browser is redirected to
# /login (signed-in session kept in an httpOnly cookie) before any page/data is
# served. false = open local mode (no login wall).
REQUIRE_AUTH=false
# Set true ONLY behind HTTPS — a secure cookie is not sent over http://localhost.
COOKIE_SECURE=false
