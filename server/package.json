{
  "name": "unico-auth-server",
  "version": "1.0.0",
  "private": true,
  "description": "Secure auth + data backend for the UNICO desktop app. Holds the MongoDB connection string server-side; the desktop app NEVER does.",
  "main": "index.js",
  "scripts": {
    "setup": "node setup.js",
    "start": "node index.js",
    "build": "node ../scripts/build-renderer.js",
    "web": "node ../scripts/build-renderer.js && node web.js",
    "seed": "node seed-admin.js",
    "seed-departments": "node seed-departments.js",
    "seed-data": "node seed-data.js",
    "test": "node test/auth.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0"
  }
}
