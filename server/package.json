{
  "name": "unico-auth-server",
  "version": "1.0.0",
  "private": true,
  "description": "Secure auth + data backend for the UNICO desktop app. Holds the MongoDB connection string server-side; the desktop app NEVER does.",
  "main": "index.js",
  "scripts": {
    "setup": "node setup.js",
    "start": "node index.js",
    "build": "node ../scripts/build-renderer.js",
    "web": "node ../scripts/build-renderer.js && node web.js",
    "seed": "node seed-admin.js",
    "seed-departments": "node seed-departments.js",
    "seed-data": "node seed-data.js",
    "d1-migrate": "node d1-migrate.js",
    "d1-import": "node d1-import.js --verify",
    "d1-rows": "node d1-rows.js",
    "test": "node test/auth.test.js && node test/access.test.js && node test/cache.test.js && node test/loadbalancer.test.js && node test/cache-race.test.js && node test/medicines.test.js && node test/d1-store.test.js && node test/d1-admin.test.js",
    "test:med": "node test/medicines.test.js",
    "test:access": "node test/access.test.js",
    "test:cache": "node test/cache.test.js",
    "test:lb": "node test/loadbalancer.test.js",
    "test:race": "node test/cache-race.test.js",
    "test:db": "node test/db.test.js",
    "keepalive": "node keepalive.js",
    "cache:flush": "node cache-flush.js",
    "test:d1": "node test/d1-store.test.js && node test/d1-admin.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0"
  }
}
