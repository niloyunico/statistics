{
  "name": "unico-statistics-suite",
  "productName": "UNICO Statistics Suite",
  "version": "2.0.0",
  "description": "UNICO Healthcare — Statistics Suite (offline desktop application)",
  "author": "UNICO Healthcare",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.js",
    "verify": "node scripts/verify-packaged.js",
    "vendor": "node scripts/vendor.js",
    "icon": "node scripts/make-icon.js",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.unico.statistics.suite",
    "productName": "UNICO Statistics Suite",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "UNICO Statistics Suite ${version}.exe"
    },
    "compression": "maximum",
    "asar": true
  },
  "devDependencies": {
    "@babel/standalone": "^7.29.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "png-to-ico": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5"
  }
}
